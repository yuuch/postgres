#!/bin/sh
set -eu

tmp="$(mktemp)"
tmp_expected="$(mktemp)"
cleanup() {
  rm -f "$tmp"
  rm -f "$tmp_expected"
  rm -f "$tmp.normalized" "$tmp.stripped"
  db_name="${DB_NAME:-pg_opt}"
  "@PSQL@" -h localhost -p 3306 -d postgres -X -q -v ON_ERROR_STOP=1 -c "DROP DATABASE IF EXISTS ${db_name};" >/dev/null 2>&1 || true
}

trap cleanup EXIT INT TERM

if [ -z "${SQL_FILE:-}" ] || [ -z "${EXPECTED_FILE:-}" ]; then
  echo "SQL_FILE and EXPECTED_FILE must be set" >&2
  exit 1
fi

sed "s|LOAD 'pg_duckdbopt';|LOAD '@BUILD_DIR@/pg_duckdbopt.dylib';|" "$SQL_FILE" |
  "@PSQL@" -h localhost -p 3306 -d postgres -a -q -X -v ON_ERROR_STOP=1 -f - >"$tmp"

sed "s|LOAD '@BUILD_DIR@/pg_duckdbopt.dylib';|LOAD 'pg_duckdbopt';|" "$tmp" >"$tmp.normalized"
sed "s/[[:space:]]*$//" "$tmp.normalized" >"$tmp.stripped"
sed "s/[[:space:]]*$//" "$EXPECTED_FILE" >"$tmp_expected"
mv "$tmp.stripped" "$tmp"

diff -u "$tmp_expected" "$tmp"
