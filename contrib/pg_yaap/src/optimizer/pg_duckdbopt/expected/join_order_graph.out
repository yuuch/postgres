   LogicalCrossProduct(estimated_cardinality=160000)
     LogicalComparisonJoin(type=INNER, perform_delim=false, any_join=false, invert_result=false, propagate_null_values=false, is_lateral_join=false, conditions=[BoundFunction(=#NNN, children=[BoundColumnRef(t1.id, binding=#[0.0]), BoundColumnRef(t2.id, binding=#[1.0])])], estimated_cardinality=80)
       LogicalGet(table=t1, table_index=#NNN, pg_rtindex=1, relid=NNN, filters=[], estimated_cardinality=20)
       LogicalGet(table=t2, table_index=#NNN, pg_rtindex=2, relid=NNN, filters=[], estimated_cardinality=20)
     LogicalComparisonJoin(type=INNER, perform_delim=false, any_join=false, invert_result=false, propagate_null_values=false, is_lateral_join=false, conditions=[BoundFunction(=#NNN, children=[BoundColumnRef(t3.id, binding=#[2.0]), BoundColumnRef(t4.id, binding=#[3.0])])], estimated_cardinality=2000)
       LogicalGet(table=t3, table_index=#NNN, pg_rtindex=3, relid=NNN, filters=[], estimated_cardinality=100)
       LogicalGet(table=t4, table_index=#NNN, pg_rtindex=4, relid=NNN, filters=[], estimated_cardinality=100)

