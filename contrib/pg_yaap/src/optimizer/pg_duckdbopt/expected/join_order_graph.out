   PhysicalCrossProduct(estimated_cardinality=160000)
     PhysicalHashJoin(type=INNER, dependent=false, invert_result=false, conditions=[BoundFunction(=#NNN, children=[BoundColumnRef(t1.id, binding=#[0.0]), BoundColumnRef(t2.id, binding=#[1.0])])], estimated_cardinality=80)
