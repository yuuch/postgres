\c postgres
SET client_min_messages = warning;
DROP DATABASE IF EXISTS pg_opt_join_semi_anti_reorder;
CREATE DATABASE pg_opt_join_semi_anti_reorder;
\c pg_opt_join_semi_anti_reorder
SET client_min_messages = warning;
CREATE TABLE t1(id int, col int);
CREATE TABLE t2(id int, col int);
CREATE TABLE t3(id int, col int);
INSERT INTO t1
SELECT i, i
FROM generate_series(1, 1000) AS g(i);
INSERT INTO t2
SELECT i, i
FROM generate_series(1, 10) AS g(i);
INSERT INTO t3
SELECT i, i
FROM generate_series(1, 10) AS g(i);
ANALYZE t1;
ANALYZE t2;
ANALYZE t3;
LOAD 'pg_duckdbopt';
SET client_min_messages = error;
\pset format unaligned
\t on
CREATE FUNCTION explain_filter(text) RETURNS SETOF text
LANGUAGE plpgsql AS
$$
DECLARE
    ln text;
BEGIN
    FOR ln IN EXECUTE $1 LOOP
        ln := regexp_replace(ln, 'relid=[0-9]+', 'relid=NNN', 'g');
        ln := regexp_replace(ln, '#[0-9]+', '#NNN', 'g');
        IF ln ~ '^[[:space:]]*explain_filter[[:space:]]*$' THEN
            ln := 'explain_filter';
        ELSIF ln ~ '^[[:space:]-]+$' THEN
            ln := '----------------';
        ELSIF ln <> '' THEN
            ln := ' ' || ln;
        END IF;
        RETURN NEXT ln;
    END LOOP;
END;
$$;
SELECT explain_filter($$EXPLAIN (VERBOSE, COSTS OFF)
SELECT *
FROM t1
WHERE id = ALL (SELECT t2.id FROM t2 JOIN t3 ON t2.id = t3.id)$$);
 Custom Scan (DuckDBScan)
   DuckDB Logical Plan: Logical Plan:
 LogicalProjection(table_index=#NNN, output_names=[id, col], expressions=[BoundColumnRef(t1.id, binding=#[0.0]), BoundColumnRef(t1.col, binding=#[0.1])], estimated_cardinality=10)
   LogicalComparisonJoin(type=ANTI, children_swapped=true, perform_delim=false, any_join=false, invert_result=false, propagate_null_values=false, is_lateral_join=false, conditions=[BoundFunction(=#NNN, children=[BoundColumnRef(t1.id, binding=#[0.0]), BoundColumnRef(subquery.id, binding=#[3.0])])], estimated_cardinality=10)
     LogicalGet(table=t1, table_index=#NNN, pg_rtindex=1, relid=NNN, filters=[], estimated_cardinality=1000)
     LogicalProjection(table_index=#NNN, output_names=[id], expressions=[BoundColumnRef(t2.id, binding=#[1.0])], estimated_cardinality=10)
       LogicalComparisonJoin(type=INNER, perform_delim=false, any_join=false, invert_result=false, propagate_null_values=false, is_lateral_join=false, conditions=[BoundFunction(=#NNN, children=[BoundColumnRef(t2.id, binding=#[1.0]), BoundColumnRef(t3.id, binding=#[2.0])])], estimated_cardinality=20)
         LogicalGet(table=t2, table_index=#NNN, pg_rtindex=1, relid=NNN, filters=[], estimated_cardinality=10)
         LogicalGet(table=t3, table_index=#NNN, pg_rtindex=2, relid=NNN, filters=[], estimated_cardinality=10)

 Physical Plan:
 PhysicalProjection(select_list=[BoundColumnRef(t1.id, binding=#[0.0]), BoundColumnRef(t1.col, binding=#[0.1])], output_names=[id, col], estimated_cardinality=10)
   PhysicalHashJoin(type=ANTI, dependent=false, children_swapped=true, invert_result=false, conditions=[BoundFunction(=#NNN, children=[BoundColumnRef(t1.id, binding=#[0.0]), BoundColumnRef(subquery.id, binding=#[3.0])])], estimated_cardinality=10)
     PhysicalTableScan(table=t1, table_index=#NNN, pg_rtindex=1, filters=[], estimated_cardinality=1000)
     PhysicalProjection(select_list=[BoundColumnRef(t2.id, binding=#[1.0])], output_names=[id], estimated_cardinality=10)
       PhysicalHashJoin(type=INNER, dependent=false, invert_result=false, conditions=[BoundFunction(=#NNN, children=[BoundColumnRef(t2.id, binding=#[1.0]), BoundColumnRef(t3.id, binding=#[2.0])])], estimated_cardinality=20)
         PhysicalTableScan(table=t2, table_index=#NNN, pg_rtindex=1, filters=[], estimated_cardinality=10)
         PhysicalTableScan(table=t3, table_index=#NNN, pg_rtindex=2, filters=[], estimated_cardinality=10)

SELECT explain_filter($$EXPLAIN (VERBOSE, COSTS OFF)
SELECT *
FROM t1
WHERE NOT (id = ALL (SELECT t2.id FROM t2 JOIN t3 ON t2.id = t3.id))$$);
