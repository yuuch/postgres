     PhysicalTableScan(table=t1, table_index=#NNN, pg_rtindex=1, filters=[], estimated_cardinality=1000)
     PhysicalProjection(select_list=[BoundColumnRef(t2.id, binding=#[1.0])], output_names=[id], estimated_cardinality=10)
       PhysicalHashJoin(type=INNER, dependent=false, invert_result=false, conditions=[BoundFunction(=#NNN, children=[BoundColumnRef(t2.id, binding=#[1.0]), BoundColumnRef(t3.id, binding=#[2.0])])], estimated_cardinality=20)
         PhysicalTableScan(table=t2, table_index=#NNN, pg_rtindex=1, filters=[], estimated_cardinality=10)
