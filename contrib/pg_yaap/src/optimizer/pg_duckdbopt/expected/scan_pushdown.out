\c postgres
SET client_min_messages = warning;
DROP DATABASE IF EXISTS pg_opt_scan;
CREATE DATABASE pg_opt_scan;
\c pg_opt_scan
SET client_min_messages = warning;
CREATE TABLE t1(id int, col int);
CREATE TABLE t2(id int, col int);
INSERT INTO t1
SELECT i,
       CASE
         WHEN i <= 20 THEN 1
         WHEN i <= 30 THEN 2
         ELSE i
       END
FROM generate_series(1, 100) AS g(i);
INSERT INTO t2
SELECT i,
       CASE
         WHEN i <= 10 THEN NULL::int
         ELSE i
       END
FROM generate_series(1, 50) AS g(i);
ANALYZE t1;
ANALYZE t2;
LOAD 'pg_duckdbopt';
SET client_min_messages = error;
\pset format unaligned
\t on
CREATE FUNCTION explain_filter(text) RETURNS SETOF text
LANGUAGE plpgsql AS
$$
DECLARE
    ln text;
BEGIN
    FOR ln IN EXECUTE $1 LOOP
        ln := regexp_replace(ln, 'relid=[0-9]+', 'relid=NNN', 'g');
        ln := regexp_replace(ln, '#[0-9]+', '#NNN', 'g');
        IF ln ~ '^[[:space:]]*explain_filter[[:space:]]*$' THEN
            ln := 'explain_filter';
        ELSIF ln ~ '^[[:space:]-]+$' THEN
            ln := '----------------';
        ELSIF ln <> '' THEN
            ln := ' ' || ln;
        END IF;
        RETURN NEXT ln;
    END LOOP;
END;
$$;
SELECT explain_filter($$EXPLAIN (VERBOSE, COSTS OFF) SELECT col FROM t1 WHERE col = 1$$);
 Custom Scan (DuckDBScan)
   DuckDB Logical Plan: Logical Plan:
 LogicalProjection(table_index=#NNN, output_names=[col], expressions=[BoundColumnRef(t1.col, binding=#[0.1])], estimated_cardinality=21)
   LogicalGet(table=t1, table_index=#NNN, pg_rtindex=1, relid=NNN, filters=[BoundFunction(=#NNN, children=[BoundColumnRef(t1.col, binding=#[0.1]), BoundConstant(1)])], estimated_cardinality=21)

 Physical Plan:
 PhysicalProjection(select_list=[BoundColumnRef(t1.col, binding=#[0.1])], output_names=[col], estimated_cardinality=21)
   PhysicalTableScan(table=t1, table_index=#NNN, pg_rtindex=1, filters=[BoundFunction(=#NNN, children=[BoundColumnRef(t1.col, binding=#[0.1]), BoundConstant(1)])], estimated_cardinality=21)

SELECT explain_filter($$EXPLAIN (VERBOSE, COSTS OFF) SELECT col FROM t1 WHERE col < 50$$);
 Custom Scan (DuckDBScan)
   DuckDB Logical Plan: Logical Plan:
 LogicalProjection(table_index=#NNN, output_names=[col], expressions=[BoundColumnRef(t1.col, binding=#[0.1])], estimated_cardinality=50)
   LogicalGet(table=t1, table_index=#NNN, pg_rtindex=1, relid=NNN, filters=[BoundFunction(<#NNN, children=[BoundColumnRef(t1.col, binding=#[0.1]), BoundConstant(50)])], estimated_cardinality=50)

 Physical Plan:
 PhysicalProjection(select_list=[BoundColumnRef(t1.col, binding=#[0.1])], output_names=[col], estimated_cardinality=50)
   PhysicalTableScan(table=t1, table_index=#NNN, pg_rtindex=1, filters=[BoundFunction(<#NNN, children=[BoundColumnRef(t1.col, binding=#[0.1]), BoundConstant(50)])], estimated_cardinality=50)

SELECT explain_filter($$EXPLAIN (VERBOSE, COSTS OFF) SELECT * FROM t2 WHERE col IS NULL$$);
 Custom Scan (DuckDBScan)
   DuckDB Logical Plan: Logical Plan:
 LogicalProjection(table_index=#NNN, output_names=[id, col], expressions=[BoundColumnRef(t2.id, binding=#[0.0]), BoundColumnRef(t2.col, binding=#[0.1])], estimated_cardinality=10)
   LogicalGet(table=t2, table_index=#NNN, pg_rtindex=1, relid=NNN, filters=[BoundFunction(is_null#NNN, children=[BoundColumnRef(t2.col, binding=#[0.1])])], estimated_cardinality=10)

 Physical Plan:
 PhysicalProjection(select_list=[BoundColumnRef(t2.id, binding=#[0.0]), BoundColumnRef(t2.col, binding=#[0.1])], output_names=[id, col], estimated_cardinality=10)
   PhysicalTableScan(table=t2, table_index=#NNN, pg_rtindex=1, filters=[BoundFunction(is_null#NNN, children=[BoundColumnRef(t2.col, binding=#[0.1])])], estimated_cardinality=10)

SELECT explain_filter($$EXPLAIN (VERBOSE, COSTS OFF) SELECT * FROM t1, t2 WHERE t1.id = t2.id AND t1.col = 1 AND t2.col > 40$$);
 Custom Scan (DuckDBScan)
   DuckDB Logical Plan: Logical Plan:
 LogicalProjection(table_index=#NNN, output_names=[id, col, id, col], expressions=[BoundColumnRef(t1.id, binding=#[0.0]), BoundColumnRef(t1.col, binding=#[0.1]), BoundColumnRef(t2.id, binding=#[1.0]), BoundColumnRef(t2.col, binding=#[1.1])], estimated_cardinality=42)
   LogicalComparisonJoin(type=INNER, perform_delim=false, any_join=false, invert_result=false, propagate_null_values=false, is_lateral_join=false, conditions=[BoundFunction(=#NNN, children=[BoundColumnRef(t1.id, binding=#[0.0]), BoundColumnRef(t2.id, binding=#[1.0])])], estimated_cardinality=42)
     LogicalGet(table=t1, table_index=#NNN, pg_rtindex=1, relid=NNN, filters=[BoundFunction(=#NNN, children=[BoundColumnRef(t1.col, binding=#[0.1]), BoundConstant(1)])], estimated_cardinality=21)
     LogicalGet(table=t2, table_index=#NNN, pg_rtindex=2, relid=NNN, filters=[BoundFunction(>#NNN, children=[BoundColumnRef(t2.col, binding=#[1.1]), BoundConstant(40)])], estimated_cardinality=10)

 Physical Plan:
 PhysicalProjection(select_list=[BoundColumnRef(t1.id, binding=#[0.0]), BoundColumnRef(t1.col, binding=#[0.1]), BoundColumnRef(t2.id, binding=#[1.0]), BoundColumnRef(t2.col, binding=#[1.1])], output_names=[id, col, id, col], estimated_cardinality=42)
   PhysicalHashJoin(type=INNER, dependent=false, invert_result=false, conditions=[BoundFunction(=#NNN, children=[BoundColumnRef(t1.id, binding=#[0.0]), BoundColumnRef(t2.id, binding=#[1.0])])], estimated_cardinality=42)
     PhysicalTableScan(table=t1, table_index=#NNN, pg_rtindex=1, filters=[BoundFunction(=#NNN, children=[BoundColumnRef(t1.col, binding=#[0.1]), BoundConstant(1)])], estimated_cardinality=21)
     PhysicalTableScan(table=t2, table_index=#NNN, pg_rtindex=2, filters=[BoundFunction(>#NNN, children=[BoundColumnRef(t2.col, binding=#[1.1]), BoundConstant(40)])], estimated_cardinality=10)

SELECT explain_filter($$EXPLAIN (VERBOSE, COSTS OFF) SELECT * FROM t1 JOIN t2 ON t1.id = t2.id AND t1.col = 1 AND t2.col > 40$$);
 Custom Scan (DuckDBScan)
   DuckDB Logical Plan: Logical Plan:
 LogicalProjection(table_index=#NNN, output_names=[id, col, id, col], expressions=[BoundColumnRef(t1.id, binding=#[0.0]), BoundColumnRef(t1.col, binding=#[0.1]), BoundColumnRef(t2.id, binding=#[1.0]), BoundColumnRef(t2.col, binding=#[1.1])], estimated_cardinality=42)
   LogicalComparisonJoin(type=INNER, perform_delim=false, any_join=false, invert_result=false, propagate_null_values=false, is_lateral_join=false, conditions=[BoundFunction(=#NNN, children=[BoundColumnRef(t1.id, binding=#[0.0]), BoundColumnRef(t2.id, binding=#[1.0])])], estimated_cardinality=42)
     LogicalGet(table=t1, table_index=#NNN, pg_rtindex=1, relid=NNN, filters=[BoundFunction(=#NNN, children=[BoundColumnRef(t1.col, binding=#[0.1]), BoundConstant(1)])], estimated_cardinality=21)
     LogicalGet(table=t2, table_index=#NNN, pg_rtindex=2, relid=NNN, filters=[BoundFunction(>#NNN, children=[BoundColumnRef(t2.col, binding=#[1.1]), BoundConstant(40)])], estimated_cardinality=10)

 Physical Plan:
 PhysicalProjection(select_list=[BoundColumnRef(t1.id, binding=#[0.0]), BoundColumnRef(t1.col, binding=#[0.1]), BoundColumnRef(t2.id, binding=#[1.0]), BoundColumnRef(t2.col, binding=#[1.1])], output_names=[id, col, id, col], estimated_cardinality=42)
   PhysicalHashJoin(type=INNER, dependent=false, invert_result=false, conditions=[BoundFunction(=#NNN, children=[BoundColumnRef(t1.id, binding=#[0.0]), BoundColumnRef(t2.id, binding=#[1.0])])], estimated_cardinality=42)
     PhysicalTableScan(table=t1, table_index=#NNN, pg_rtindex=1, filters=[BoundFunction(=#NNN, children=[BoundColumnRef(t1.col, binding=#[0.1]), BoundConstant(1)])], estimated_cardinality=21)
     PhysicalTableScan(table=t2, table_index=#NNN, pg_rtindex=2, filters=[BoundFunction(>#NNN, children=[BoundColumnRef(t2.col, binding=#[1.1]), BoundConstant(40)])], estimated_cardinality=10)

\t off
\pset format aligned
\c postgres
DROP DATABASE pg_opt_scan;
